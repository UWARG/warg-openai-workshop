COHERE_API_KEY=replace-me
COHERE_MODEL=command-a-plus-05-2026

# Configure Mission Planner to forward MAVLink to this local UDP port.
MAVLINK_CONNECTION=udpin:127.0.0.1:14550

# Flight commands remain disabled until explicitly enabled.
LIVE_COMMANDS=true
MAX_ALTITUDE_M=5
MAX_MOVE_M=3
MAX_VERTICAL_MOVE_M=2
MAX_YAW_DEGREES=90
HEARTBEAT_TIMEOUT_S=10
COMMAND_TIMEOUT_S=5

# Minimum delay between tools requested together in one Cohere response.
TOOL_CALL_DELAY_S=5
